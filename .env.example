# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/labtrack_db

# JWT Authentication
JWT_SECRET=supersecret_labtrack_jwt_key_2026_secured
JWT_EXPIRES_IN=7d

# Email Notifications (Optional: Leave blank to use Ethereal SMTP test fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LabTrack System" <noreply@labtrack.edu>
